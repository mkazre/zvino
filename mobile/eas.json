{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "base": {
      "env": {
        "EXPO_PUBLIC_API_URL": "https://zvino.online",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true"
      }
    },
    "customer-dev": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8001"
      },
      "channel": "customer-dev"
    },
    "driver-dev": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "driver",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8001"
      },
      "channel": "driver-dev"
    },
    "merchant-dev": {
      "extends": "base",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "APP_VARIANT": "merchant",
        "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8001"
      },
      "channel": "merchant-dev"
    },
    "customer": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "customer"
      },
      "channel": "customer"
    },
    "driver": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "driver"
      },
      "channel": "driver"
    },
    "merchant": {
      "extends": "base",
      "autoIncrement": true,
      "env": {
        "APP_VARIANT": "merchant"
      },
      "channel": "merchant"
    },
    "customer-preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "customer",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.55:8001",
        "ALLOW_HTTP": "1"
      },
      "channel": "customer-preview"
    },
    "driver-preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "driver",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.55:8001",
        "ALLOW_HTTP": "1"
      },
      "channel": "driver-preview"
    },
    "merchant-preview": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "merchant",
        "EXPO_PUBLIC_API_URL": "http://192.168.1.55:8001",
        "ALLOW_HTTP": "1"
      },
      "channel": "merchant-preview"
    },
    "customer-online": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "customer"
      },
      "channel": "customer-online"
    },
    "driver-online": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "driver"
      },
      "channel": "driver-online"
    },
    "merchant-online": {
      "extends": "base",
      "distribution": "internal",
      "android": {
        "buildType": "apk"
      },
      "env": {
        "APP_VARIANT": "merchant"
      },
      "channel": "merchant-online"
    }
  },
  "submit": {
    "customer": {},
    "driver": {},
    "merchant": {}
  }
}
