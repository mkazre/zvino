{
  "cli": { "version": ">= 16.0.0", "appVersionSource": "remote" },
  "build": {
    "base": { "env": { "EXPO_PUBLIC_API_URL": "https://zvino.co.zw" } },

    "customer-dev": { "extends": "base", "developmentClient": true, "distribution": "internal", "env": { "APP_VARIANT": "customer", "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8001" } },
    "driver-dev": { "extends": "base", "developmentClient": true, "distribution": "internal", "env": { "APP_VARIANT": "driver", "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8001" } },
    "merchant-dev": { "extends": "base", "developmentClient": true, "distribution": "internal", "env": { "APP_VARIANT": "merchant", "EXPO_PUBLIC_API_URL": "http://10.0.2.2:8001" } },

    "customer": { "extends": "base", "autoIncrement": true, "env": { "APP_VARIANT": "customer" } },
    "driver": { "extends": "base", "autoIncrement": true, "env": { "APP_VARIANT": "driver" } },
    "merchant": { "extends": "base", "autoIncrement": true, "env": { "APP_VARIANT": "merchant" } }
  },
  "submit": {
    "customer": {},
    "driver": {},
    "merchant": {}
  }
}
