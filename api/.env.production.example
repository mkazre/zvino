# ─── Zvino on cPanel (zvino.online) ─────────────────────────────────────────────
# The deploy script copies this to ~/zvino-app/.env on the first deploy and fills in APP_KEY.
# Edit it there (cPanel → File Manager → zvino-app/.env). Never commit the real .env.

APP_NAME=Zvino
# "staging" keeps demo payments and the 123456 test login code working while Paynow/SMS
# aren't set up yet. Change to "production" (and APP_DEBUG=false) when you go live.
APP_ENV=staging
APP_KEY=
APP_DEBUG=false
APP_URL=https://zvino.online
APP_VERSION=1.0.0
APP_TIMEZONE=Africa/Harare

LOG_CHANNEL=daily
LOG_LEVEL=warning

# cPanel → MySQL Database Wizard (names get the zvinoonl_ prefix)
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=zvinoonl_zvino
DB_USERNAME=zvinoonl_zvino
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

# Live updates (pusher.com). Leave as "log" until you have keys; the apps poll instead.
BROADCAST_CONNECTION=log
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

# Paynow (EcoCash / OneMoney / InnBucks / card). PAYNOW_FAKE only works when APP_ENV is not "production".
PAYNOW_FAKE=true
PAYNOW_INTEGRATION_ID=
PAYNOW_INTEGRATION_KEY=
PAYNOW_MERCHANT_EMAIL=

# Email (cPanel → Email Accounts, e.g. orders@zvino.online; SMTP host is usually mail.zvino.online)
MAIL_MAILER=log
MAIL_HOST=mail.zvino.online
MAIL_PORT=465
MAIL_USERNAME=orders@zvino.online
MAIL_PASSWORD=
MAIL_ENCRYPTION=ssl
MAIL_FROM_ADDRESS=orders@zvino.online
MAIL_FROM_NAME=Zvino

# Error monitoring (sentry.io), optional
SENTRY_LARAVEL_DSN=

# ── First-deploy helpers (the deploy script reads these, then you can delete them) ──
# Load the demo stores/menus/logins once (for testing only; never on the real launch database).
ZVINO_SEED_DEMO=true
# Create your super admin automatically (password: 10+ chars, upper + lower case + a number).
ZVINO_ADMIN_EMAIL=
ZVINO_ADMIN_PASSWORD=
